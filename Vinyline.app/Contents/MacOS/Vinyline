#!/bin/bash
# Lance le serveur Vinyline en arrière-plan ; il choisit lui-même un port libre et ouvre la page admin.
# Si le serveur tourne déjà, ouvre juste la page. Il s'arrête avec le bouton « Éteindre »
# de la page admin, ou tout seul après 30 minutes sans aucune page ouverte.
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
PORT_FILE="$ROOT/.server-port"
LOG="$HOME/Library/Logs/vinyline.log"

# Vrai si le port noté dans .server-port est bien celui d'un serveur Vinyline qui répond
running() {
  [ -f "$PORT_FILE" ] && curl -sf -m 1 "http://127.0.0.1:$(cat "$PORT_FILE")/info" | grep -q '"app": *"vinyline"'
}

if running; then
  open "http://127.0.0.1:$(cat "$PORT_FILE")/host"
  exit 0
fi

cd "$ROOT" || exit 1
nohup python3 game/server.py --idle-exit 1800 > "$LOG" 2>&1 &
disown
for _ in $(seq 1 40); do running && exit 0; sleep 0.25; done

osascript -e "display alert \"Vinyline n'a pas pu démarrer\" message \"Détails dans $LOG\""
